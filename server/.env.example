MONGODB_URI=mongodb://127.0.0.1:27017/witting
CLIENT_URL=http://localhost:5173
PORT=5000
# Set true when the server runs behind one trusted reverse proxy (Render,
# Railway, nginx, etc.) so rate limits use the real client IP.
TRUST_PROXY=false

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=witting-api
JWT_AUDIENCE=witting-client
